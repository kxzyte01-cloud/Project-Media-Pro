<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Used exclusively for optional, user-initiated HTTPS download of the offline Open Whisper model in Settings. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Phase 3: in-app voiceover recording (user-initiated, runtime-requested). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Strip auto-merged library network-state permission to keep offline-first posture strict. -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <application
        android:usesCleartextTraffic="false"
        android:name=".MediaProApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ProjectMediaPro">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ProjectMediaPro">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
